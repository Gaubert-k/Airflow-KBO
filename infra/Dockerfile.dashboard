# MS-09 — dashboard supervision (hors image Airflow)
FROM python:3.11-slim-bookworm

WORKDIR /app

COPY requirements-dashboard.txt /tmp/requirements-dashboard.txt
RUN pip install --no-cache-dir \
    -r /tmp/requirements-dashboard.txt \
    sqlalchemy==2.0.36 \
    psycopg2-binary==2.9.10

ENV PYTHONPATH=/app
EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/api/health', timeout=3)"

CMD ["python", "-m", "uvicorn", "packages.dashboard.app:app", "--host", "0.0.0.0", "--port", "8090"]
