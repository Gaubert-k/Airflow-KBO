# Copier vers infra/.env pour Docker Compose :
#   cp .env.example infra/.env

# --- Identité Airflow (image officielle) ---
AIRFLOW_UID=50000
AIRFLOW_GID=0
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- Chemins projet (montés dans les conteneurs) ---
AIRFLOW_PROJ_DIR=/home/guillaume/Bureau/Airflow TP
AIRFLOW_DAGS_DIR=/home/guillaume/Bureau/Airflow TP/airflow/dags
AIRFLOW_PACKAGES_DIR=/home/guillaume/Bureau/Airflow TP/packages

# --- Connexion métadonnées (géré par docker-compose ; surcharge optionnelle) ---
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow

# --- Core Airflow ---
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# --- PYTHONPATH pour importer packages/ depuis les tasks ---
# Parent du dossier packages/ (voir montage Docker : …/packages → /opt/airflow/packages)
PYTHONPATH=/opt/airflow

# --- URLs publiques (placeholders MS futurs — pas de secrets) ---
KBO_PUBLIC_BASE_URL=https://kbopub.economie.fgov.be/kbopub/
BNB_CONSULT_BASE_URL=https://consult.cbso.nbb.be/
MONITEUR_EJUSTICE_BASE_URL=https://www.ejustice.just.fgov.be/cgi_tsv/

# --- HDFS / stockage brut (MS-03) ---
HDFS_RAW_ROOT=hdfs://localhost:9000/raw/v1
HDFS_LOCAL_ROOT=/opt/airflow/data/hdfs-stub

# --- Base métier (MS-05) — conteneur postgres ; hôte : localhost:5432 ---
DATABASE_URL=postgresql://app:app@postgres:5432/belgian_companies

# --- MS-02 acquisition — Tor KBO (recommandé) ---
ACQUISITION_USE_PROXIES=0
ACQUISITION_ALLOW_DIRECT=1
ACQUISITION_USE_TOR=1
ACQUISITION_TOR_PROXIES=socks5h://tor1:9050,socks5h://tor2:9050,socks5h://tor3:9050
ACQUISITION_KBO_DIRECT_FIRST=1
ACQUISITION_TOR_LOOP_MIN_INTERVAL_S=600
ACQUISITION_HTTP_TIMEOUT_S=60
